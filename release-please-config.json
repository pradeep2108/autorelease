{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    "backend": {
      "release-type": "go",
      "changelog-path": "backend/CHANGELOG.md",
      "component": "backend",
      "include-component-in-tag": true,
      "tag-separator": "-"
    },
    "frontend": {
      "release-type": "node",
      "changelog-path": "frontend/CHANGELOG.md",
      "component": "frontend",
      "include-component-in-tag": true,
      "tag-separator": "-"
    }
  },
  "target-branch": "main"
}
